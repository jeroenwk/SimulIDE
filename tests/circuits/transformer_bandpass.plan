# Same bandpass, with a genuine single 50mH transformer winding as the inductor.
comp add WaveGen --label GEN --at 0,0 Wave_Type=Sine Freq=2055Hz Semi_Ampli=1V Mid_Volt=0V Steps=1000 Always_On=true
comp add Capacitor --label C1 --at 96,0 Capacitance=120nF
comp add Transformer --label T1 --at 192,0 Primary=1 Secondary=0 BaseInd=50mH
comp add Resistor --label R1 --at 176,80 --rot 90 Resistance=54
comp add Ground --label G --at 176,144
wire add GEN.outnod C1.lPin
wire add C1.rPin T1.P00Pin
wire add T1.P01Pin R1.lPin
wire add R1.rPin G.Gnd
settings set reactStep=10ns
